<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PSVellumPDF.PreflightResult</Name>
      <ViewSelectedBy><TypeName>PSVellumPDF.PreflightResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Profile</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Compliant</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Errors</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Warnings</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Profile</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsCompliant</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ErrorCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WarningCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSVellumPDF.PreflightAssertion</Name>
      <ViewSelectedBy><TypeName>PSVellumPDF.PreflightAssertion</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Severity</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Rule</Label><Width>44</Width></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RuleId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSVellumPDF.PdfInfo</Name>
      <ViewSelectedBy><TypeName>PSVellumPDF.PdfInfo</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Pages</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Encrypted</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Signatures</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Claims</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>PageCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsEncrypted</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Signatures).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.ClaimedProfiles) -join ', '</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
