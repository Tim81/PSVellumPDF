<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project exists only to acquire the VellumPdf .NET 10 assemblies that the
    PSVellumPDF PowerShell module loads at import time. It produces no shipping code.
    `build.ps1` publishes it and copies the runtime assemblies into ../lib.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Besides acquiring VellumPdf, this project compiles the small C# shims in
         ./Interop into PSVellumPDF.Interop.dll (see Interop/*.cs for why). -->
    <AssemblyName>PSVellumPDF.Interop</AssemblyName>
    <RootNamespace>PSVellumPDF.Interop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Keep the publish output flat and self-contained so lib/ holds plain DLLs. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Pin the full dependency closure. packages.lock.json is committed; CI
         restores with RestoreLockedMode so transitive drift fails the build.
         After bumping a PackageReference, regenerate the lock file with:
           dotnet restore dependencies/Dependencies.csproj "/p:RestoreLockedMode=false" (add the force-evaluate flag) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VellumPdf.Layout" Version="2.3.3" />
    <!-- VellumPdf.Kernel comes in transitively via VellumPdf.Layout. -->
    <PackageReference Include="VellumPdf.Signing" Version="2.3.3" />
    <!-- VellumPdf.Reader comes in transitively via VellumPdf.Signing (LTV) and Conformance. -->
    <PackageReference Include="VellumPdf.Barcodes" Version="2.3.3" />
    <PackageReference Include="VellumPdf.Conformance" Version="2.3.3" />
    <PackageReference Include="VellumPdf.Reader" Version="2.3.3" />
    <PackageReference Include="VellumPdf.Fonts.Standard14" Version="2.3.3" />
    <!-- Compile-time only: ScriptBlock for ScriptBlockRenderer. The host (pwsh)
         supplies the real assembly at run time, so never copy it into lib/. -->
    <PackageReference Include="System.Management.Automation" Version="7.6.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
