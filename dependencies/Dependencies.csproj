<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project exists only to acquire the VellumPdf .NET 10 assemblies that the
    PSVellumPDF PowerShell module loads at import time. It produces no shipping code.
    `build.ps1` publishes it and copies the runtime assemblies into ../lib.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Besides acquiring VellumPdf, this project compiles the small C# shims in
         ./Interop into PSVellumPDF.Interop.dll (see Interop/*.cs for why). -->
    <AssemblyName>PSVellumPDF.Interop</AssemblyName>
    <RootNamespace>PSVellumPDF.Interop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Keep the publish output flat and self-contained so lib/ holds plain DLLs. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- No lock file on purpose: System.Security.Cryptography.Pkcs below floats to the
         newest 10.0.x at every restore, and a floating reference cannot be locked. The
         VellumPdf references are exact versions, so only Pkcs (and other transitive
         packages) can move. Restores are therefore not bit-for-bit reproducible. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VellumPdf.Layout" Version="2.3.3" />
    <!-- VellumPdf.Kernel comes in transitively via VellumPdf.Layout. -->
    <PackageReference Include="VellumPdf.Signing" Version="2.3.3" />
    <!-- VellumPdf.Reader comes in transitively via VellumPdf.Signing (LTV) and Conformance. -->
    <PackageReference Include="VellumPdf.Barcodes" Version="2.3.3" />
    <PackageReference Include="VellumPdf.Conformance" Version="2.3.3" />
    <PackageReference Include="VellumPdf.Reader" Version="2.3.3" />
    <PackageReference Include="VellumPdf.Fonts.Standard14" Version="2.3.3" />
    <!-- Always the newest Pkcs 10.0.x. VellumPdf.Signing pulls in an exact (older) version
         transitively; this direct reference wins, so restore warnings about known
         advisories in that old version go away as soon as a fixed release exists. It is a
         build-time package only: build.ps1 never copies it to lib/, and at run time Signing
         uses the System.Security.Cryptography.Pkcs that ships with PowerShell. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
    <!-- Compile-time only: ScriptBlock for ScriptBlockRenderer. The host (pwsh)
         supplies the real assembly at run time, so never copy it into lib/. -->
    <PackageReference Include="System.Management.Automation" Version="7.7.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
